{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend-dev-db",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd backend && DATABASE_URL=sqlite:///./dev.db ENVIRONMENT=development .venv/bin/uvicorn main:app --port 8001 --reload"],
      "port": 8001
    },
    {
      "name": "frontend",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd frontend && VITE_ADDRESS=http://localhost:8001 npx vite --port 5173 --strictPort"],
      "port": 5173
    }
  ]
}
